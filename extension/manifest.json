{
  "manifest_version": 3,
  "name": "Responder Já",
  "short_name": "Responder Já",
  "version": "0.1.1",
  "description": "Gere respostas às avaliações com IA dentro do Google, Booking e Tripadvisor, na língua do cliente.",
  "default_locale": "pt_PT",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Responder Já",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "contextMenus", "activeTab", "scripting"],
  "host_permissions": ["https://www.responderja.pt/*"]
}
